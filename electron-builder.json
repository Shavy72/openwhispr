{
  "appId": "com.flowbase.stimme",
  "productName": "Flowbase Stimme",
  "extraMetadata": {
    "windowsTrayIdentity": false
  },
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/flowbase/main/**/*",
    "src/helpers/**/*",
    "src/utils/process.js",
    "src/updater.js",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",

    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",

    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",

    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",

    "!**/node_modules/postcss/**",
    "!**/node_modules/autoprefixer/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",

    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/tw-animate-css/**",
    "!**/node_modules/react-markdown/**",
    "!**/node_modules/shadcn-ui/**",

    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/@electron/notarize/**",

    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**"
  ],
  "asarUnpack": ["**/node_modules/@napi-rs/keyring/**/*"],
  "extraResources": [
    {
      "from": "src/assets",
      "to": "src/assets",
      "filter": ["icon.png", "icon.ico", "icon.icns", "iconTemplate@3x.png"]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "artifactName": "Flowbase-Stimme-${arch}.${ext}",
    "icon": "src/assets/icon.icns",
    "identity": null,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Flowbase Stimme nutzt das Mikrofon, um deine Sprache für Diktat und Sprachnachrichten aufzunehmen.",
      "NSAccessibilityUsageDescription": "Flowbase Stimme braucht Bedienungshilfen-Rechte, um Text und Sprachnachrichten in andere Apps einzufügen."
    }
  },
  "win": {
    "target": ["nsis"],
    "icon": "src/assets/icon.ico",
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "resources/bin/",
        "to": "bin/",
        "filter": ["windows-fast-paste*", "nircmd.exe"]
      }
    ]
  },
  "linux": {
    "executableName": "flowbase-stimme",
    "target": ["AppImage"],
    "icon": "src/assets/icon.png",
    "category": "Utility",
    "artifactName": "Flowbase-Stimme.${ext}"
  },
  "appImage": {
    "artifactName": "Flowbase-Stimme.${ext}"
  },
  "nsis": {
    "artifactName": "Flowbase-Stimme-Setup.${ext}",
    "guid": "6f1c2b9e-4d3a-4e8f-9b57-2a7c1d0e5f43",
    "shortcutName": "Flowbase Stimme",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "dmg": {
    "title": "Flowbase Stimme",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "publish": {
    "provider": "github",
    "owner": "Shavy72",
    "repo": "openwhispr",
    "private": false,
    "releaseType": "release"
  }
}
